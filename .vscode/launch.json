{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AeroGaze Android · Dev",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/apps/mobile",
      "program": "${workspaceFolder}/apps/mobile/lib/main.dart",
      "flutterMode": "debug",
      "toolArgs": ["--flavor", "dev"]
    },
    {
      "name": "AeroGaze Android · Prod",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/apps/mobile",
      "program": "${workspaceFolder}/apps/mobile/lib/main.dart",
      "flutterMode": "debug",
      "toolArgs": ["--flavor", "prod"]
    },
    {
      "name": "AeroGaze Android · Dev (Profile)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/apps/mobile",
      "program": "${workspaceFolder}/apps/mobile/lib/main.dart",
      "flutterMode": "profile",
      "toolArgs": ["--flavor", "dev", "--dart-define=TRACE_STARTUP=true"]
    }
  ]
}
